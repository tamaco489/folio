# Claude Code local settings (personal environment only)
.claude/settings.local.json

# Temporary files
tmp/

# Lambda build artifacts
backend/bin/

# Lambda Layer archives
backend/**/*.zip

# Sample PDFs fetched from arXiv (default license forbids redistribution)
backend/testdata/pdf/

# Terraform working directory and state
infra/**/.terraform/
infra/**/*.tfstate*

# Lock files written by infra/scripts/validate.sh when validating modules standalone
# (only envs/*/.terraform.lock.hcl is committed; Terraform ignores lock files in child modules)
infra/modules/**/.terraform.lock.hcl

# Environment variables
.env
