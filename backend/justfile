# testdata の配置規約
#
#   testdata/pdf/       サンプル PDF。arXiv のデフォルトライセンスは再配布不可のため git 管理外とし、tools/fetch-corpus で取得する
#   testdata/textract/  記録済み Textract レスポンス。{論文 ID}.json
#   testdata/bedrock/   記録済み Bedrock レスポンス。{論文 ID}-{経路}.json
#
# Textract と Bedrock は課金が発生するため、テストは記録済みレスポンスの再生で行う
#
# レシピにシェルの処理を書かない。複数行になる処理は scripts/ に置き、ここでは呼び出すだけにする

default:
    @just --list

fmt:
    go fmt ./...

vet:
    go vet ./...

# 設定は .golangci.yml。バージョンはルートの .tool-versions (asdf) と CI の Action で揃える
lint:
    golangci-lint run ./...

test:
    go test ./...

# go fix の提案を差分で表示する (適用しない)
fix-diff:
    go fix -diff ./...

# go fix の提案を適用する
fix:
    go fix ./...

# gopls の modernize 解析器 (errorsastype など go fix に無いもの) の提案を表示する (適用しない)
modernize:
    go run golang.org/x/tools/gopls/internal/analysis/modernize/cmd/modernize@latest -test ./...

# modernize の提案を適用する
modernize-fix:
    go run golang.org/x/tools/gopls/internal/analysis/modernize/cmd/modernize@latest -fix -test ./...

# ビルド対象を列挙する (cmd/ からの相対パス。例: pipeline/validator)
cmds:
    @scripts/cmds.sh

# 全 Lambda をクロスコンパイルする
build:
    @scripts/build.sh

# 単一の Lambda をクロスコンパイルする (例: just build-one pipeline/validator)
build-one cmd:
    @scripts/build.sh "{{ cmd }}"

# ビルド成果物を配布用の zip に固める
package: build
    @scripts/package.sh

# 反映は infra の just plan / just apply で行い、update-function-code は使わない
# 配布用の zip を artifacts バケット ({env}-folio-artifacts-{アカウント ID}) へアップロードする (実行はユーザー)
upload env="dev": package
    @scripts/upload.sh functions "{{ env }}"

# Layer の zip をアップロードする (先に layers/pdf-processor/build.sh で作る)
upload-layer env="dev":
    @scripts/upload.sh layer "{{ env }}"

# ビルド成果物を削除する
clean:
    @scripts/clean.sh
