# testdata の配置規約
#
#   testdata/pdf/       サンプル PDF。arXiv のデフォルトライセンスは再配布不可のため git 管理外とし、tools/fetch-corpus で取得する
#   testdata/textract/  記録済み Textract レスポンス。{論文 ID}.json
#   testdata/bedrock/   記録済み Bedrock レスポンス。{論文 ID}-{経路}.json
#
# Textract と Bedrock は課金が発生するため、テストは記録済みレスポンスの再生で行う
#
# レシピにシェルの処理を書かない。複数行になる処理は scripts/ に置き、ここでは呼び出すだけにする

default:
    @just --list

fmt:
    go fmt ./...

vet:
    go vet ./...

test:
    go test ./...

# ビルド対象を列挙する (cmd/ からの相対パス。例: pipeline/validator)
cmds:
    @scripts/cmds.sh

# 全 Lambda をクロスコンパイルする
build:
    @scripts/build.sh

# 単一の Lambda をクロスコンパイルする (例: just build-one pipeline/validator)
build-one cmd:
    @scripts/build.sh "{{ cmd }}"

# ビルド成果物を配布用の zip に固める
package: build
    @scripts/package.sh

# ビルド成果物を削除する
clean:
    @scripts/clean.sh
